# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/

# Editors and operating systems
.vscode/
.idea/
*.swp
*.orig
*.rej
*.bak
Thumbs.db
desktop.ini

# Environment files and operator state. These hold server secrets or live
# device credentials and must never enter a release or a commit. The
# database rule is not anchored to a directory because a live store lands
# wherever the operator started the process.
.env
.env.*
!.env.example
relay.env
secrets/
GuildHub/.env
GuildHub/data/
GuildHub/downloads/*
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Runtime state the client, worker and Discord adapter write when pointed
# at a checkout instead of their state directories.
*.log
sessions.json
overlay-settings.json
update-available.json

# Atomic-write temp files. A force-killed companion leaves these behind.
*.tmp

# Build output
dist/
Installer/build/
Installer/cache/
# Visual Studio's developer-prompt banner, dropped in the working
# directory by vcvars64.bat whenever the native launcher is built.
vcvars.log
/.ci-results/

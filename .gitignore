__pycache__/
*.pyc
.venv/
node_modules/
.env
.env.*
!.env.example
relay.env
secrets/
GearHelper/GearHelper-import.txt

# Generated by the companions from Raidbots and Warcraft Logs data.
# Never committed: it carries other players names, report codes and parses,
# and the addon READMEs forbid redistributing API-derived datasets.
GearHelper/Data/Generated.lua
BossTalents/Data/Generated.lua
ReadyRoom/Data/Generated.lua

# Companion liveness files, rewritten every 30 seconds while watching.
GearHelper/Data/Heartbeat.lua
BossTalents/Data/Heartbeat.lua

# Written beside the heartbeat as a request progresses, and carrying the
# character GUID the request was made for. A sibling of the two lines above
# that arrived later and was not covered by them.
*/Data/Status.lua

# Vemal's Ears operator state. These contain server secrets or live device
# credentials and must never enter a release or commit.
GuildHub/.env
# Not anchored to GuildHub/, because the database is not: the job API
# defaults --jobs-database to the bare name "hosted-jobs.sqlite3", so it
# lands wherever the operator started the process - which in practice is
# the repository root, outside the GuildHub/ rules these replaced. A live
# jobs database holds device credentials; no path is worth risking.
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
hosted-jobs-data/
GuildHub/data/
GuildHub/downloads/*
!GuildHub/downloads/README.md

# Atomic-write temp files. A force-killed companion (the normal stop path
# uses taskkill /F) leaves these behind, holding the same third-party data.
*.tmp

# Build output
dist/
Installer/build/
# Visual Studio's developer-prompt banner, dropped in the working
# directory by vcvars64.bat whenever the native launcher is built.
vcvars.log
Installer/cache/

# Backups and staging copies of generated data. Generated.lua itself
# is listed above, but a suffixed copy is not covered by that line -
# and 7082 lines of sim output reached a commit that way.
*/Data/Generated.lua.*
*/Data/Heartbeat.lua.*

# Isolated Warpsim research dependencies, native binaries and benchmark output.
Warpsim/.deps/
Warpsim/.work/
/.ci-results/

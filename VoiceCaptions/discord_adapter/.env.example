# Copy these names into the companion's protected local configuration.
# Never commit a real bot token.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=

# Optional: register commands in one guild during development.
DISCORD_GUILD_ID=

# Optional receive-segment tuning.
CAPTIONS_SILENCE_MS=500
CAPTIONS_CONNECT_TIMEOUT_MS=15000
CAPTIONS_MAX_SEGMENT_MS=30000
